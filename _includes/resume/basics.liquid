<div class="cv-header text-center mb-4">
  <h2 class="font-weight-bold mb-1">{{ data[1].name }}</h2>
  <h6 class="mb-3">{{ data[1].title }}</h6>

  <div class="cv-social-links mt-2">
    {% if data[1].email %}
      <a href="mailto:{{ data[1].email }}" class="mx-2"> <i class="fas fa-envelope"></i> {{ 'Email' }} </a>
    {% endif %}

    {% for profile in data[1].profiles %}
      <a href="{{ profile.url }}" target="_blank" rel="noopener noreferrer" class="mx-2">
        {% assign icon_class = profile.network | downcase %}
        {% if icon_class == 'linkedin' %}
          <i class="fab fa-linkedin"></i>
        {% elsif icon_class == 'github' %}
          <i class="fab fa-github"></i>
        {% elsif icon_class == 'instagram' %}
          <i class="fab fa-instagram"></i>
        {% elsif icon_class == 'google scholar' %}
          <i class="ai ai-google-scholar"></i>
        {% else %}
          <i class="fas fa-globe"></i>
        {% endif %}
        {{ profile.network }}
      </a>
    {% endfor %}
  </div>
</div>
